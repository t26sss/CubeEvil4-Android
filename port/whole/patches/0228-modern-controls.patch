+    const u64 modern_on = Key.on;
+    const u64 modern_trg = Key.trg;
+    const int modern = re4ModernPrepare(pEm);
     Pl_func_move_tbl[pEm->r_no_1](pEm);
+    if (modern) {
+        Key.on = (Key.on & ~(u64) 0xF) | (modern_on & 0xF);
+        Key.trg = (Key.trg & ~(u64) 0xF) | (modern_trg & 0xF);
+    }
 }
 
