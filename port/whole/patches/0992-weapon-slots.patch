+// Port (patch 0992), weapon slots on the digital pad (wish of a user, 19.11.2026): while Leon moves freely (routine 0)
+// the four directions of the pad pick a weapon instead of walking: up, right, down, left = slot 0..3. A slot holds an
+// item id of the inventory (0 = empty) or the knife. Hold L and press a direction to put the weapon in his hands (or the
+// knife, when it is the one picked) in that slot; L + the direction of a slot that already holds his weapon makes it the knife. The slot of the knife does not change the gun in his hands: with it
+// picked, Leon walks as always and the aim key (R) draws the knife (the game's own knife stance, joyLKamae in
+// pl_sub.cpp) instead of aiming the gun; the fire key slashes. The knife is shown in his hand (gun hidden) while it is picked. The L key itself is not the knife stance any more (it
+// is the key that assigns the slots). A gun slot swaps the gun the way the inventory does when it is closed
+// (SubScreenExit: weaponRelease / weaponLoad / weaponInit), only from the standing, walking or running routines.
+// The pad is taken out of the keys of this frame's player routine only (restored at the end of move()), so windows,
+// menus and ladders still read it as the game does. Slots start with the knife on the left; they are not saved.
+#define RE4_SLOT_KNIFE 0xFFFE
+int g_re4_knife_slot = 0;
+static u16 g_re4_slot_id[4] = { 0, 0, 0, RE4_SLOT_KNIFE };
+static u16 g_re4_knife_ref = 0xFFFF;
+static u64 g_re4_slot_save_on;
+static u64 g_re4_slot_save_trg;
+static u64 g_re4_slot_save_rep;
+static u64 g_re4_slot_save_rep2;
+static int g_re4_slot_masked = 0;
+
+static void re4SlotEquip(cPlayer* pl, cItem* p)
+{
+    if (ItemMgr.weapon() != p && ItemMgr.arm(p) == 0) {
+        return;
+    }
+    {
+        const u8 wepNo = WeaponId2WeaponNo(ItemMgr.weaponId());
+        const u8 wepType = WeaponId2WeaponType(ItemMgr.weaponId());
+        const int wepLv = ItemMgr.weapon() ? ItemMgr.weapon()->getBulletType() : 0;
+
+        if (pG->weapon_no != wepNo || pG->weapon_type != wepType || pG->bullet_type != wepLv) {
+            SndBlkStop(2);
+            pl->weaponRelease();
+            pl->weaponLoad(wepNo, wepType);
+            pG->bullet_type = wepLv;
+            pl->weaponInit();
+        }
+    }
+}
+
+// Before the routine of this frame: the slot keys, then the pad out of the movement keys.
+static void re4SlotPre(cPlayer* pl)
+{
+    g_re4_slot_masked = 0;
+    if (pG->pl_type != 0) {
+        g_re4_knife_slot = 0;
+        return;
+    }
+    if (g_re4_knife_slot && ItemMgr.weaponId() != g_re4_knife_ref) {
+        g_re4_knife_slot = 0;  // another weapon was armed meanwhile (the inventory): the gun is back
+    }
+    if (pl->r_no_0 != 0) {
+        return;
+    }
+    {
+        const u32 trg = Joy[0].trg & 0xF;  // JOY_LEFT 1, JOY_RIGHT 2, JOY_DOWN 4, JOY_UP 8
+
+        if (trg && StaFlagChk(pG, STA_SSCRN_ENABLE)) {
+            const int idx = (trg & JOY_UP) ? 0 : (trg & JOY_RIGHT) ? 1 : (trg & JOY_DOWN) ? 2 : 3;
+
+            if (Joy[0].on & JOY_L) {
+                // L held: this slot gets what he holds now
+                if (g_re4_knife_slot) {
+                    g_re4_slot_id[idx] = RE4_SLOT_KNIFE;
+                    SndCall(0, 3, 0, 0, 0, 0);
+                } else if (ItemMgr.weapon() != 0) {
+                    // pressing it again for the weapon the slot already holds turns the slot into the knife
+                    g_re4_slot_id[idx] = (g_re4_slot_id[idx] == ItemMgr.weapon()->id) ? RE4_SLOT_KNIFE : ItemMgr.weapon()->id;
+                    SndCall(0, 3, 0, 0, 0, 0);
+                }
+            } else if (pl->r_no_1 <= 4 && !(Key.on & 0x10)) {
+                const u16 id = g_re4_slot_id[idx];
+
+                if (id == RE4_SLOT_KNIFE) {
+                    g_re4_knife_slot = 1;
+                    g_re4_knife_ref = ItemMgr.weaponId();
+                } else if (id != 0) {
+                    cItem* p = ItemMgr.search(id);
+
+                    if (p != 0 && p->num != 0) {
+                        g_re4_knife_slot = 0;
+                        re4SlotEquip(pl, p);
+                    }
+                }
+            }
+        }
+    }
+    // the pad does not walk Leon: only what the stick sets stays of the direction keys (bits 0-3 and 24-27 are
+    // pad | stick, 32-35 the pad alone)
+    {
+        const u32 on = Joy[0].on;
+        u64 clr = (u64) 0xF << 32;
+
+        if (!(on & JOY_SUP)) {
+            clr |= ((u64) 1 << 0) | ((u64) 1 << 24);
+        }
+        if (!(on & JOY_SDOWN)) {
+            clr |= ((u64) 1 << 1) | ((u64) 1 << 25);
+        }
+        if (!(on & JOY_SLEFT)) {
+            clr |= ((u64) 1 << 2) | ((u64) 1 << 26);
+        }
+        if (!(on & JOY_SRIGHT)) {
+            clr |= ((u64) 1 << 3) | ((u64) 1 << 27);
+        }
+        g_re4_slot_save_on = Key.on;
+        g_re4_slot_save_trg = Key.trg;
+        g_re4_slot_save_rep = Key.rep;
+        g_re4_slot_save_rep2 = Key.rep2;
+        Key.on &= ~clr;
+        Key.trg &= ~clr;
+        Key.rep &= ~clr;
+        Key.rep2 &= ~clr;
+        g_re4_slot_masked = 1;
+    }
+}
+
+// The knife picked on the pad is in his hand all the time: the knife model on, the gun hidden (what the game does
+// for the knife stance), so he walks and runs with it. Done at the end of the frame, after the routines that reset it;
+// when the knife is put away again the gun is shown and the knife hidden.
+static int g_re4_knife_shown = 0;
+
+static void re4KnifeShow(cPlayer* pl, int on)
+{
+    if (pl->Wep != 0 && pl->Wep->m_pWep != 0) {
+        switch (pG->weapon_no) {
+        case 0x13:
+        case 0x16:
+        case 0x17:
+        case 0x19:
+        case 0x1F:
+        case 0x20:
+            if (pl->Wep->m_pWepHand == 0) {
+                break;
+            }
+        default:
+            setWepTrans(pl, on ? 0 : 1);
+            break;
+        case 0xD:
+            break;
+        }
+    }
+    if (pl->Body != 0) {
+        pl->Body->setKnife(on != 0);
+    }
+}
+
+static void re4SlotPost(cPlayer* pl)
+{
+    if (pG->pl_type == 0 && g_re4_knife_slot) {
+        re4KnifeShow(pl, 1);
+        g_re4_knife_shown = 1;
+    } else if (g_re4_knife_shown) {
+        g_re4_knife_shown = 0;
+        re4KnifeShow(pl, 0);
+    }
+    if (g_re4_slot_masked) {
+        Key.on = g_re4_slot_save_on;
+        Key.trg = g_re4_slot_save_trg;
+        Key.rep = g_re4_slot_save_rep;
+        Key.rep2 = g_re4_slot_save_rep2;
+        g_re4_slot_masked = 0;
+    }
+}
+
